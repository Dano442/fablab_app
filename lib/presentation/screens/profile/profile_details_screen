import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';

import 'package:fablab_app/data/services/user_service.dart';
import 'package:fablab_app/domain/models/user_model.dart';
import 'package:fablab_app/utils/jwt_helper.dart';

class ProfileDetailsScreen extends StatefulWidget {
  const ProfileDetailsScreen({super.key});

  @override
  State<ProfileDetailsScreen> createState() => _ProfileDetailsScreenState();
}

class _ProfileDetailsScreenState extends State<ProfileDetailsScreen> {
  final _formKey = GlobalKey<FormState>();
  final _userService = UserService();

  bool _isLoading = true;
  bool _isEditing = false;

  UserModel? _user;

  late TextEditingController _nameController;
  late TextEditingController _lastnameController;
  late TextEditingController _emailController;
  late TextEditingController _careerController;
  late TextEditingController _phoneController;

  @override
  void initState() {
    super.initState();
    _loadUser();
  }

  Future<void> _loadUser() async {
    final email = await JwtHelper.getUserEmail();

    if (email == null) {
      debugPrint("❌ No se encontró el email del usuario en el JWT");
      setState(() => _isLoading = false);
      return;
    }

    final user = await _userService.getUserByEmail(email);

    if (user != null) {
      _user = user;

      _nameController = TextEditingController(text: user.nombre);
      _lastnameController = TextEditingController(text: user.apellido);
      _emailController = TextEditingController(text: user.correoInstitucional);
      _careerController = TextEditingController(text: user.carrera);
      _phoneController = TextEditingController(text: user.telefono);
    } else {
      debugPrint("❌ No se encontró usuario con el correo $email");
    }

    setState(() => _isLoading = false);
  }

  String? _validateLetters(String? value) {
    if (value == null || value.isEmpty) return "Campo obligatorio";
    if (!RegExp(r'^[a-zA-ZÀ-ÿ\s]+$').hasMatch(value)) {
      return "Solo se permiten letras";
    }
    return null;
  }

  String? _validatePhone(String? value) {
    if (value == null || value.isEmpty) return "Ingrese teléfono";
    if (!RegExp(r'^[0-9]{9}$').hasMatch(value)) {
      return "Teléfono debe tener 9 dígitos";
    }
    return null;
  }

  Future<void> _saveProfile() async {
    if (!_formKey.currentState!.validate()) return;

    final updated = UserModel(
      id: _user!.id,
      nombre: _nameController.text.trim(),
      apellido: _lastnameController.text.trim(),
      rut: _user!.rut,
      correoInstitucional: _user!.correoInstitucional,
      carrera: _careerController.text.trim(),
      telefono: _phoneController.text.trim(),
      laboratorioId: _user!.laboratorioId,
      laboratorio: _user!.laboratorio,
      rolId: _user!.rolId,
      tipoRol: _user!.tipoRol,
      descripcionRol: _user!.descripcionRol,
      imgUrl: _user!.imgUrl,
    );

    final success = await _userService.updateUser(updated);

    if (success) {
      setState(() {
        _user = updated;
        _isEditing = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('✅ Perfil actualizado')),
      );
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('❌ No se pudo actualizar')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    final colors = Theme.of(context).colorScheme;

    if (_isLoading) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }

    if (_user == null) {
      return const Scaffold(
        body: Center(child: Text("No se pudo cargar el usuario")),
      );
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text("Perfil de Usuario"),
        backgroundColor: colors.primary,
        foregroundColor: colors.onPrimary,
        actions: [
          IconButton(
            icon: Icon(_isEditing ? Icons.close : Icons.edit),
            onPressed: () {
              setState(() => _isEditing = !_isEditing);
            },
          )
        ],
        leading: IconButton(
          icon: Icon(Icons.arrow_back, color: colors.onPrimary),
          onPressed: () => context.go('/profile'),
        ),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            Center(
              child: CircleAvatar(
                radius: 60,
                backgroundImage: (_user!.imgUrl != null &&
                        _user!.imgUrl!.isNotEmpty)
                    ? NetworkImage(_user!.imgUrl!)
                    : const NetworkImage(
                        "https://cdn-icons-png.flaticon.com/512/149/149071.png"),
              ),
            ),

            const SizedBox(height: 20),

            Form(
              key: _formKey,
              child: Column(
                children: [
                  TextFormField(
                    controller: _nameController,
                    enabled: _isEditing,
                    validator: _validateLetters,
                    decoration: const InputDecoration(
                      prefixIcon: Icon(Icons.person),
                      labelText: "Nombre",
                      border: OutlineInputBorder(),
                    ),
                  ),
                  const SizedBox(height: 16),

                  TextFormField(
                    controller: _lastnameController,
                    enabled: _isEditing,
                    validator: _validateLetters,
                    decoration: const InputDecoration(
                      prefixIcon: Icon(Icons.person_outline),
                      labelText: "Apellido",
                      border: OutlineInputBorder(),
                    ),
                  ),
                  const SizedBox(height: 16),

                  TextFormField(
                    controller: _emailController,
                    enabled: false,
                    decoration: const InputDecoration(
                      labelText: "Correo",
                      border: OutlineInputBorder(),
                      prefixIcon: Icon(Icons.email),
                    ),
                  ),
                  const SizedBox(height: 16),

                  TextFormField(
                    controller: _careerController,
                    enabled: _isEditing,
                    decoration: const InputDecoration(
                      labelText: "Carrera",
                      border: OutlineInputBorder(),
                      prefixIcon: Icon(Icons.school),
                    ),
                  ),
                  const SizedBox(height: 16),

                  TextFormField(
                    controller: _phoneController,
                    enabled: _isEditing,
                    validator: _validatePhone,
                    decoration: const InputDecoration(
                      labelText: "Teléfono",
                      border: OutlineInputBorder(),
                      prefixIcon: Icon(Icons.phone),
                    ),
                  ),
                  const SizedBox(height: 30),

                  if (_isEditing)
                    ElevatedButton.icon(
                      onPressed: _saveProfile,
                      icon: const Icon(Icons.save),
                      label: const Text("Guardar cambios"),
                      style: ElevatedButton.styleFrom(
                        minimumSize: const Size(double.infinity, 50),
                        backgroundColor: colors.primary,
                        foregroundColor: colors.onPrimary,
                      ),
                    )
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
